# Optional: Compose works without an .env file, using the key-free demo model.
# For Gemini, set AI_MODEL=google:gemini-3.6-flash and add an AI Studio key.
AI_MODEL=demo
GOOGLE_API_KEY=


# Container-to-container URLs (Docker service names).
BACKEND_URL=http://backend:8000
MCP_URL=http://mcp:8001/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
DATABASE_URL=sqlite:////data/demo.db

# Local SigNoz root account, provisioned automatically at startup.
# Password needs 12+ characters with uppercase, lowercase, a digit, and a symbol.
SIGNOZ_USER_ROOT_ENABLED=true
SIGNOZ_USER_ROOT_EMAIL=admin@admin.at
SIGNOZ_USER_ROOT_PASSWORD=Admin123456!
SIGNOZ_USER_ROOT_ORG_NAME=default
